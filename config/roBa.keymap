/*
 * roBa keymap — Keyball44 からの移植（Windows 日本語(JIS)キーボード設定前提）
 * このファイルは手で編集してかまいません。記号は JIS で目的の文字が出るキーコードを使っています。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define MOUSE 3
#define SCROLL 4
#define SYS 5

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&trackball {
    automouse-layer = <MOUSE>;
    scroll-layers = <SCROLL>;
};

/ {
    behaviors {
        scroll_enc: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <40>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <BASE>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <BASE>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys {
            if-layers = <NAV SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q      &kp W     &kp E     &kp R                   &kp T                                             &kp Y          &kp U     &kp I      &kp O    &kp P
&kp A      &kp S     &kp D     &kp F                   &kp G               &kp LA(LEFT)       &kp MINUS  &kp H          &kp J     &kp K      &kp L    &kp SEMI
&kp Z      &kp X     &kp C     &kp V                   &kp B               &kp LA(RIGHT)      &kp SQT    &kp N          &kp M     &kp COMMA  &kp DOT  &kp SLASH
&kp LSHFT  &kp LGUI  &kp LALT  &mt LCTRL INT_MUHENKAN  &lt NAV INT_HENKAN  &kp SPACE          &kp BSPC   &lt SYM ENTER  &tog NAV
            >;
            sensor-bindings = <&scroll_enc>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&kp ESC     &kp HOME  &kp UP    &kp END    &kp PG_UP                           &kp LC(LS(T))  &kp LC(LS(TAB))  &kp LC(W)      &kp LC(TAB)  &kp LC(T)
&none       &kp LEFT   &none     &kp RIGHT  &kp LG(LS(S))  &none       &none    &kp LC(V)      &mkp MB1         &mkp MB3       &mkp MB2     &kp LC(F)
&none       &kp LC(Z)  &kp DOWN  &kp LC(Y)  &kp PG_DN      &none       &none    &kp LC(C)      &mkp MB4         &kp LG(LCTRL)  &mkp MB5     &kp LC(L)
&trans      &trans     &trans    &trans     &trans         &trans      &kp DEL  &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(LS(TAB)) LC(TAB)>;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4      &kp F5                                      &kp RBKT      &kp N7  &kp N8  &kp N9  &kp NUHS
&kp F6   &kp F7   &kp F8  &kp F9      &kp F10     &kp INT_YEN         &kp EQUAL   &kp LS(RBKT)  &kp N4  &kp N5  &kp N6  &kp LS(NUHS)
&kp F11  &kp F12  &none   &kp LS(N8)  &kp LS(N9)  &kp LS(INT_RO)      &kp LS(N1)  &kp N0        &kp N1  &kp N2  &kp N3  &kp LBKT
&trans   &trans   &trans  &trans      &trans      &trans              &trans      &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &mo SCROLL
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        sys_layer {
            display-name = "SYS";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                      &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&bt BT_CLR    &none         &none         &none         &none         &none       &none   &none         &none           &none         &none         &bt BT_CLR
&bootloader   &none         &none         &none         &sys_reset    &none       &none   &sys_reset    &none           &none         &none         &bootloader
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans        &bt BT_CLR_ALL
            >;
        };
    };
};
